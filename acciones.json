{
  "version": 1,
  "acciones": [
    {
      "nombre": "mover-imagenes",
      "descripcion": "Mueve imágenes a una carpeta imagenes/",
      "operacion": "mover",
      "patrones": [
        "*.png",
        "*.jpg",
        "*.jpeg",
        "*.webp"
      ],
      "destino": "imagenes"
    },
    {
      "nombre": "agrupar-audio",
      "descripcion": "Organiza archivos de audio en la carpeta audio/",
      "operacion": "mover",
      "patrones": [
        "*.mp3",
        "*.wav",
        "*.flac",
        "*.ogg"
      ],
      "destino": "audio"
    },
    {
      "nombre": "archivar-imagenes-duplicadas",
      "descripcion": "Conserva una copia de cada imagen y envía los duplicados a la papelera",
      "operacion": "dedup",
      "patrones": [
        "*.png",
        "*.jpg",
        "*.jpeg",
        "*.webp"
      ],
      "papelera": true
    },
    {
      "nombre": "renombrar-viejos",
      "descripcion": "Añade el sufijo -revisar a los .txt para revisarlos",
      "operacion": "renombrar",
      "patrones": [
        "*.txt"
      ],
      "sufijo": "revisar"
    }
  ]
}
