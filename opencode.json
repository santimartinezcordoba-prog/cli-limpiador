{
  "$schema": "https://opencode.ai/config.json",
  // MCP context7: SOLO para consultar documentación de librerías (aquí,
  // httpx). APAGADO por defecto: `enabled: false` para que no cargue ni
  // gaste tokens en cada sesión. Se enciende PUNTUALMENTE desde la CLI con
  // `/mcps` → context7, se consulta la doc oficial de httpx y se vuelve a
  // apagar. NO es una dependencia de `limpiador`: es una ayuda de desarrollo
  // (ver docs/adr/0002-ia-opcional-y-redaccion-de-secretos.md).
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  }
}
